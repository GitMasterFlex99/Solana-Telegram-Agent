# Telegram
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
# Required: comma-separated Telegram user IDs allowed to use the bot.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: restrict the bot to one Telegram chat ID.
TELEGRAM_CHAT_ID=

# Solana RPC used for on-chain safety checks.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: X/Twitter Bearer token. Without it, X signals are shown as unavailable.
X_BEARER_TOKEN=

# Optional: configured Pump.fun discovery endpoint. Leave blank to disable Pump.fun discovery.
PUMPFUN_DISCOVERY_ENDPOINT=

# Optional: local persistence paths.
RISK_PROFILE_FILE=data/risk-profiles.json
WATCHLIST_FILE=data/watchlists.json
ALERT_STATE_FILE=data/alert-state.json
PAPER_PORTFOLIO_FILE=data/paper-portfolios.json

# Optional: paper-trading simulation settings. These never execute real transactions.
PAPER_STARTING_BALANCE_USD=10000
PAPER_POSITION_SIZE_USD=100
PAPER_TAKE_PROFIT_PCT=25
PAPER_STOP_LOSS_PCT=15
PAPER_MAX_OPEN_POSITIONS=10
